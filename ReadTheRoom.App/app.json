{
  "expo": {
    "name": "Read The Room",
    "slug": "rtr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ReadTheRoom.png",
    "scheme": "readtheroomapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.joygle.readtheroom",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B66FF",
        "foregroundImage": "./assets/images/ReadTheRoom.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ReadTheRoom.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B66FF",
          "dark": {
            "backgroundColor": "#0B66FF"
          }
        }
      ],
      "expo-web-browser",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier may be used to deliver more relevant ads."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "rewardedAdTestMode": true,
      "eas": {
        "projectId": "51c2e02c-ad8d-4291-8f45-de1fa8fd9ff8"
      }
    },
    "owner": "spdshts-team"
  }
}
